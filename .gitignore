# ==============================================================================
# Byte-compiled / optimized / DLL files (Python)
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ==============================================================================
# Ambientes Virtuais (Virtual Environments)
# ==============================================================================
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# ==============================================================================
# Variáveis de Ambiente e Credenciais (Secrets)
# ==============================================================================
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# ==============================================================================
# Distribuição / Build / Empacotamento
# ==============================================================================
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ==============================================================================
# Testes, Cobertura e Qualidade de Código (Lint / Typing)
# ==============================================================================
.pytest_cache/
.coverage
.coverage.*
nosetests.xml
coverage.xml
*.cover
*.py,cover
htmlcov/
.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json

# ==============================================================================
# Armazenamento e Bancos Vetoriais (Vector Store / Databases)
# ==============================================================================
qdrant_storage/
*.sqlite
*.sqlite3
*.db

# ==============================================================================
# Arquivos Reais, Sensíveis e Dados de Entrada
# ==============================================================================
# Pasta dedicada para você colocar os arquivos reais / confidenciais de investigação
data/real/*
!data/real/.gitkeep

# Relatórios brutos (PDFs reais ou sintéticos gerados pelo seed)
data/raw_reports/*
!data/raw_reports/.gitkeep

# Dados processados e intermediários
data/processed/*
!data/processed/.gitkeep

# Ground truth ou benchmarks reais / confidenciais
data/*_real.*
data/real_*.*

# PDFs de dados (evita versionar documentos investigativos por engano)
*.pdf
!docs/*.pdf

# ==============================================================================
# Geração de Relatórios (Outputs do Benchmark e Avaliação)
# ==============================================================================
# Pasta de geração de relatórios (ignora todas as execuções e comparativos)
reports/*
!reports/.gitkeep

# ==============================================================================
# Logs e Arquivos Temporários
# ==============================================================================
*.log
logs/
*.pid

# ==============================================================================
# Editores e IDEs
# ==============================================================================
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# ==============================================================================
# Arquivos do Sistema Operacional
# ==============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
