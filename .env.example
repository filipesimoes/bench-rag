# Shared / Fallback OpenAI-compatible API Configuration
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# Generator LLM Endpoint
GENERATOR_BASE_URL=https://api.openai.com/v1
GENERATOR_API_KEY=your-generator-api-key-here
GENERATOR_MODEL=gpt-4o-mini
GENERATOR_MAX_TOKENS=8192
GENERATOR_TEMPERATURE=0.0
# GENERATOR_ENABLE_THINKING=false
# GENERATOR_DIALECT=auto

# Judge LLM Endpoint
JUDGE_BASE_URL=https://api.openai.com/v1
JUDGE_API_KEY=your-judge-api-key-here
JUDGE_MODEL=gpt-4o-mini
JUDGE_MAX_TOKENS=2048
# JUDGE_ENABLE_THINKING=false
# JUDGE_DIALECT=auto

# Embedding Model Endpoint
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=your-embedding-api-key-here
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_QUERY_PREFIX=""
EMBEDDING_DOCUMENT_PREFIX=""

# Reranker Endpoint (vLLM / TEI / Cohere / Jina)
RERANKER_BASE_URL=http://localhost:8000/v1
RERANKER_API_KEY=your-reranker-api-key-here
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Qdrant Vector Database
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION_NAME=police_reports
QDRANT_TIMEOUT=60.0

# Pipeline Defaults
DEFAULT_CHUNK_SIZE=1000
DEFAULT_CHUNK_OVERLAP=200
DEFAULT_TOP_K=5

# HTTP Client Timeouts & Retries (seconds)
GENERATOR_TIMEOUT=180.0
JUDGE_TIMEOUT=180.0
EMBEDDING_TIMEOUT=60.0
RERANKER_TIMEOUT=120.0
HTTP_MAX_RETRIES=3
HTTP_RETRY_BACKOFF=2.0

# Logging
LOG_LEVEL=INFO
